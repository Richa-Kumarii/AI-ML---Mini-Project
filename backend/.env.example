# AI-Powered Smart Multi-Platform Content Generator Configuration

# NVIDIA API Configuration
# Get your free/trial key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Server Configuration
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# SQLite Database
DATABASE_URL=sqlite:///./content_generator.db

